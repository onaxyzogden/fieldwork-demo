{
  "name": "fieldwork-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run design:check && npm run catalogue:check && npm run status:check && tsc && vite build",
    "test": "npm run catalogue:check && npm run status:check && node --test scripts/catalogue.test.mjs && vitest run src",
    "catalogue:generate": "node scripts/catalogue.mjs",
    "catalogue:check": "node scripts/catalogue.mjs --check",
    "design:check": "node scripts/design-check.mjs",
    "status:check": "node scripts/status-check.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.2",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
